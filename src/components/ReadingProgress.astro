---
// Reading progress bar — fixed at top, fills as user scrolls down the post.
// Shown only on post pages (Post.astro includes this component).
---

<div
  id="reading-progress"
  role="progressbar"
  aria-label="Reading progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  style="
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 3px;
    background-color: var(--global-theme-color);
    z-index: 9999;
    transition: width 0.1s linear;
  "
>
</div>

<script>
  let controller: AbortController | null = null;

  function initReadingProgress() {
    controller?.abort();
    controller = null;
    const bar = document.getElementById('reading-progress');
    if (!bar) return;

    controller = new AbortController();
    const { signal } = controller;

    const update = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct =
        docHeight > 0 ? Math.max(0, Math.min(100, Math.round((scrollTop / docHeight) * 100))) : 0;
      bar.style.width = `${pct}%`;
      bar.setAttribute('aria-valuenow', String(pct));
    };

    window.addEventListener('scroll', update, { passive: true, signal });
    window.addEventListener('resize', update, { signal });
    update();
  }

  initReadingProgress();
  document.addEventListener('astro:page-load', initReadingProgress);
  document.addEventListener('astro:before-swap', () => controller?.abort());
</script>
