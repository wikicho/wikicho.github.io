---
import PostCard from '@components/blog/PostCard.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', (post) => !post.data.hidden && !post.data.draft);
  const categories = [...new Set(allPosts.flatMap((post) => post.data.categories))];
  return categories.map((category) => ({
    // Astro expects decoded pathnames; retain escapes only for reserved URL delimiters.
    params: { category: decodeURI(encodeURIComponent(category)) },
    props: {
      category,
      posts: allPosts
        .filter((post) => post.data.categories.includes(category))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { category, posts } = Astro.props;
---

<Page title={`${site.blog.name} — ${category}`} description={site.blog.description}>
  <p><a class="back-link" href={`${site.base}/blog/`}>&larr; {site.blog.name}</a></p>
  <h1>{category}</h1>
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))
    }
  </ul>
</Page>

<style>
  .back-link {
    color: var(--global-theme-color);
    text-decoration: none;
  }
  .post-list {
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  .post-list li {
    margin-bottom: 1.75rem;
  }
</style>
