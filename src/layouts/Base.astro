---
import '@styles/global.css';

import CookieConsent from '@components/CookieConsent.astro';
import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';
import SearchTrigger from '@components/search/SearchTrigger.astro';
import { site } from '@config/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  /** OG preview image (absolute URL or path) */
  image?: string;
  noindex?: boolean;
  /** Draft pages are excluded from Pagefind, including their metadata. */
  draft?: boolean;
  /** Override the robots meta tag content string (e.g. 'noindex, nofollow'). */
  robots?: string;
  /** Whether this is the homepage — injects Person JSON-LD when true */
  isHome?: boolean;
}

const {
  title = site.author.name,
  description = site.description,
  image = site.og.image || undefined,
  noindex = false,
  draft = false,
  robots,
  isHome = false,
} = Astro.props;

const pageTitle = title === site.author.name ? title : `${title} | ${site.author.name}`;
const canonicalURL = new URL(Astro.url.pathname, site.url);
// Prepend base path to root-relative images before resolving to absolute URL
const resolvedImage = image?.startsWith('/')
  ? `${import.meta.env.BASE_URL}${image.slice(1)}`
  : image;
const ogImage = resolvedImage ? new URL(resolvedImage, site.url).toString() : undefined;
const analyticsCategory = site.features.cookieConsent ? 'analytics' : undefined;
const analyticsType = site.features.cookieConsent ? 'text/plain' : undefined;
const partytownType = site.features.cookieConsent ? 'text/plain' : 'text/partytown';

// Theme color override — emit --user-* vars consumed by _colors.css ('auto' → palette default)
const color = site.theme.color;
const accentLight = color.light === 'auto' ? null : color.light;
const accentDark = color.dark === 'auto' ? null : color.dark;
const hoverLight = color.hoverLight === 'auto' ? null : color.hoverLight;
const hoverDark = color.hoverDark === 'auto' ? null : color.hoverDark;
const decls = [
  accentLight && `--user-accent-light:${accentLight};`,
  hoverLight && `--user-hover-light:${hoverLight};`,
  accentDark && `--user-accent-dark:${accentDark};`,
  hoverDark && `--user-hover-dark:${hoverDark};`,
]
  .filter(Boolean)
  .join('');
const colorOverrideStyle = decls ? `:root{${decls}}` : '';

// Person JSON-LD for homepage — helps search engines associate content with the author
const personJsonLd = isHome ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author.name,
  url: site.url,
  email: site.author.email || undefined,
  sameAs: [
    site.socials.orcid_id ? `https://orcid.org/${site.socials.orcid_id}` : null,
    site.socials.scholar_userid ? `https://scholar.google.com/citations?user=${site.socials.scholar_userid}` : null,
    site.socials.github_username ? `https://github.com/${site.socials.github_username}` : null,
  ].filter(Boolean),
}) : null;
---

<!doctype html>
<html lang={site.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {(robots || noindex) && <meta name="robots" content={robots ?? 'noindex, nofollow'} />}

    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <!-- Favicon -->
    <link rel="icon" href={`${site.base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate icon" href={`${site.base}/favicon.ico`} />

    <!-- Fonts are self-hosted via Fontsource (imported in global.css) — no FOUT -->

    <!-- KaTeX CSS is bundled via global.css (@import 'katex/dist/katex.min.css') -->

    <!-- Theme color override (from site.theme.color — 'auto' means use _colors.css defaults) -->
    {colorOverrideStyle && <Fragment set:html={`<style>${colorOverrideStyle}</style>`} />}

    <!-- Open Graph + Twitter Card -->
    {
      site.og.enabled && (
        <>
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalURL} />
          <meta property="og:type" content="website" />
          {ogImage && <meta property="og:image" content={ogImage} />}
          <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
          <meta name="twitter:title" content={pageTitle} />
          <meta name="twitter:description" content={description} />
          {ogImage && <meta name="twitter:image" content={ogImage} />}
          {site.socials.x_username && <meta name="twitter:site" content={`@${site.socials.x_username}`} />}
        </>
      )
    }

    <!-- Analytics verification tags -->
    {
      site.analytics.googleVerification && (
        <meta name="google-site-verification" content={site.analytics.googleVerification} />
      )
    }
    {
      site.analytics.bingVerification && (
        <meta name="msvalidate.01" content={site.analytics.bingVerification} />
      )
    }

    <!-- GA4 via Partytown (production only) -->
    {
      import.meta.env.PROD && site.analytics.ga4 && (
        <>
          <script
            is:inline
            transition:persist="analytics-ga4-loader"
            type={partytownType}
            data-category={analyticsCategory}
            data-type="text/partytown"
            src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.ga4}`}
          />
          <script
            transition:persist="analytics-ga4-init"
            type={partytownType}
            data-category={analyticsCategory}
            data-type="text/partytown"
            define:vars={{ ga4: site.analytics.ga4 }}
          >
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </>
      )
    }

    <!-- Cronitor RUM -->
    {
      import.meta.env.PROD && site.analytics.cronitor && (
        <script
          transition:persist="analytics-cronitor"
          type={analyticsType}
          data-category={analyticsCategory}
          define:vars={{ siteId: site.analytics.cronitor }}
          is:inline
        >
          (() => {
            window.cronitor = window.cronitor || function () {
              (window.cronitor.q = window.cronitor.q || []).push(arguments);
            };
            const script = document.createElement('script');
            script.async = true;
            script.src = 'https://rum.cronitor.io/script.js';
            script.setAttribute('data-site-id', siteId);
            document.head.appendChild(script);
          })();
        </script>
      )
    }

    <!-- Pirsch analytics -->
    {
      import.meta.env.PROD && site.analytics.pirsch && (
        <script
          is:inline
          transition:persist="analytics-pirsch"
          type={analyticsType}
          data-category={analyticsCategory}
          defer
          src="https://api.pirsch.io/pa.js"
          id="pianjs"
          data-code={site.analytics.pirsch}
        ></script>
      )
    }

    <!-- OpenPanel analytics -->
    {
      import.meta.env.PROD && site.analytics.openpanel && (
        <script
          transition:persist="analytics-openpanel"
          type={analyticsType}
          data-category={analyticsCategory}
          define:vars={{ clientId: site.analytics.openpanel }}
          is:inline
        >
          (() => {
            const script = document.createElement('script');
            script.src = 'https://openpanel.dev/op1.js';
            script.defer = true;
            script.setAttribute('data-client-id', clientId);
            document.head.appendChild(script);
          })();
        </script>
      )
    }

    <!-- Person JSON-LD (homepage only) -->
    {personJsonLd && <script type="application/ld+json" set:html={personJsonLd} />}

    <!-- View Transitions (smooth page-to-page navigation) -->
    {site.features.viewTransitions && <ClientRouter />}

    <!-- Named slot for page-specific head content (e.g. JSON-LD from Post.astro) -->
    <slot name="head" />

    <!--
      Dark mode: must run BEFORE any CSS to prevent FOUC.
      Reads stored preference, falls back to system preference, then site default.
      Re-applies after each View Transition swap to keep the theme consistent.
    -->
    <script is:inline define:vars={{ defaultTheme: site.theme.default }}>
      function applyTheme() {
        const stored = localStorage.getItem('theme');
        let theme;
        if (stored === 'light' || stored === 'dark') {
          theme = stored;
        } else if (defaultTheme === 'system') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        } else {
          theme = defaultTheme;
        }
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-theme-setting', stored || 'system');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>

  <body
    class="min-h-screen flex flex-col"
    style="padding-top: var(--navbar-height);"
    data-footer-position={site.footer.position}
    data-tooltips={site.features.tooltips ? 'true' : undefined}
    data-pagefind-ignore={draft ? 'all' : undefined}
  >
    <!-- Skip to main content (accessibility) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 px-4 py-2 rounded"
      style="background-color: var(--global-theme-color); color: var(--global-hover-text-color);"
    >
      Skip to main content
    </a>

    <Navbar />
    {site.features.search && <SearchTrigger />}

    <main id="main-content" class="flex-1" data-pagefind-body={draft ? undefined : true}>
      <slot />
    </main>

    <!-- Newsletter (shown in footer area if enabled) -->
    {site.features.newsletter && <slot name="newsletter" />}

    {site.footer.position !== 'hidden' && <Footer />}

    {site.features.cookieConsent && <CookieConsent />}

    <!-- Back to top button -->
    <button id="back-to-top" aria-label="Back to top" title="Back to top">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </button>

    <script>
      let btn = document.getElementById('back-to-top');

      function updateVisibility() {
        btn?.classList.toggle('visible', window.scrollY > 300);
      }

      function attachClick() {
        btn?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }

      window.addEventListener('scroll', updateVisibility, { passive: true });
      attachClick();

      // After each View Transition the DOM is swapped — re-query the new element,
      // re-attach the click handler, and re-evaluate visibility immediately
      // (the scroll event doesn't fire when the browser resets scroll position).
      document.addEventListener('astro:after-swap', () => {
        btn = document.getElementById('back-to-top');
        attachClick();
        updateVisibility();
      });
    </script>
  </body>
</html>
